{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "ignorePatterns": ["node_modules/", ".next/", "out/", "dist/"],
  "rules": {
    "@next/next/no-html-link-for-pages": "off"
  }
}
