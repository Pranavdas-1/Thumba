# Thumba Environment Variables
# Copy this file to .env and fill in real values (test-mode only)

# Razorpay Test-Mode Keys (NEVER use real keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Next.js Secrets
NEXTAUTH_SECRET=your-local-dev-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# Database (use the same Supabase PostgreSQL connection string in every app)
# URL-encode special characters in the password, e.g. @ becomes %40.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# App URLs
STOREFRONT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Browser-safe Supabase Realtime credentials (never use the service-role key here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase Storage (dashboard product image uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Public WhatsApp contact in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
