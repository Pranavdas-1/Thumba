# Thumba Environment Variables
# Copy this file to .env and fill in real values (test-mode only)

# Razorpay Test-Mode Keys (NEVER use real keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Next.js Secrets
NEXTAUTH_SECRET=your-local-dev-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://localhost:5432/thumba

# App URLs
STOREFRONT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Supabase Storage (dashboard product image uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Public WhatsApp contact in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
